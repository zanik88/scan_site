# --- Основные настройки ---
SECRET_KEY=change-me-to-a-long-random-string-min-32-chars
COOKIE_SECURE=false

# --- База данных ---
# В Docker Compose (SQLite в volume):
DATABASE_URL=sqlite:////app/data/saas_audit.db
# Локально без Docker (SQLite):
# DATABASE_URL=sqlite:///./saas_audit.db

# --- API-ключи ИИ (опционально) ---
YANDEX_GPT_API_KEY=
YANDEX_FOLDER_ID=
GIGACHAT_API_KEY=

# --- Каталог для отчётов ---
REPORTS_DIR=./generated_reports
